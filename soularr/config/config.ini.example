[Lidarr]
# Get from Lidarr: Settings > General > Security
api_key = your_lidarr_api_key_here
# URL Lidarr uses (e.g., what you use in your browser)
host_url = http://lidarr:8686
# Path to slskd downloads AS LIDARR SEES IT. Lidarr mounts $STORAGE_ROOT at
# /data, so this is /data/... not /downloads/... — getting this wrong makes
# every import fail with "Failed to import from: ..." while downloads succeed.
download_dir = /data/downloads/slskd/downloads
# If true, Lidarr won't auto-import from Slskd
disable_sync = False

[Slskd]
# Create manually (see docs). Must match an api_keys entry in slskd.yml.
api_key = your_slskd_api_key_here
# URL Slskd uses
host_url = http://slskd:5030
url_base = /slskd
# Download path inside the Slskd container (not the Lidarr one)
download_dir = /downloads
# Delete search after Soularr runs. Leave True: slskd retains searches
# indefinitely by default and they add up to gigabytes.
delete_searches = True
# Max seconds to wait for downloads (prevents infinite hangs)
stalled_timeout = 3600

[Release Settings]
# Pick release with most common track count
use_most_common_tracknum = True
# False rejects releases whose format is like "2xCD" — it does not control
# folder handling; Soularr merges CD1/CD2 into one folder either way.
allow_multi_disc = True
# Accepted release countries
accepted_countries = Europe,Japan,United Kingdom,United States,[Worldwide],Australia,Canada,Germany,Austria
# Accepted formats
accepted_formats = CD,Digital Media,Vinyl

[Search Settings]
search_timeout = 5000
maximum_peer_queue = 50
# Minimum upload speed (bits/sec)
minimum_peer_upload_speed = 0
# Minimum match ratio between Lidarr track and Soulseek filename
minimum_filename_match_ratio = 0.8
# Preferred file types and qualities (most to least preferred)
# Use "flac" or "mp3" to ignore quality details
#allowed_filetypes = flac 24/192,flac 16/44.1,flac,mp3 320,mp3
allowed_filetypes = mp3 320,mp3
ignored_users = #User1,User2,Fred,Bob
# Set to False to only search for album titles (Note Soularr does not search for individual tracks, this setting searches for track titles but still tries to match to the full album). 
search_for_tracks = True
# Prepend artist name when searching for albums
album_prepend_artist = True
track_prepend_artist = True
# Search modes: all, incrementing_page, first_page
# "all": search for every wanted record, "first_page": repeatedly searchs the first page, "incrementing_page": starts with the first page and increments on each run.
search_type = incrementing_page
# Albums to process per run
number_of_albums_to_grab = 4
# Unmonitor album on failure. Leave True: with False, a failing album stays
# wanted and is re-downloaded every run forever.
remove_wanted_on_failure = True
# Blacklist words in album or track titles (case-insensitive)
title_blacklist = #Word1,word2
# Lidarr search source: "missing" or "cutoff_unmet"
search_source = missing

[Logging]
# Passed to Python's logging.basicConfig()
# See: https://docs.python.org/3/library/logging.html
# DEBUG logs every HTTP call and burns ~1MB per 70 minutes.
level = INFO
format = [%(levelname)s|%(module)s|L%(lineno)d] %(asctime)s: %(message)s
datefmt = %Y-%m-%dT%H:%M:%S%z
