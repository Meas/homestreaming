# Root of your storage drive. All downloads and media live under this path.
# This single mount point is what enables hardlinking in Sonarr/Radarr/Lidarr.
# Expected layout:
#   $STORAGE_ROOT/downloads/   — torrent downloads (qBittorrent)
#   $STORAGE_ROOT/media/       — media library (Jellyfin)
STORAGE_ROOT=/mnt/your-drive

QBITTORRENT_TORRENTING_PORT=12854
QBITTORRENT_WEBUI_PORT=8080
QBITTORRENT_CONFIG_PATH=./qbittorrent/config

JELLYFIN_CONFIG_PATH=./jellyfin/config
JELLYFIN_CACHE_PATH=./jellyfin/cache

NGINX_HOST_PORT=80
NGINX_HTTPS_PORT=443
NGINX_CONFIG_NAME=http-only #https other option
NGINX_SHARE_FILES=

# --- Immich ---
# Pin the version: the remote ML box (immich/remote-ml.yml) must run the same one.
IMMICH_VERSION=v3
# Port nginx serves Immich on. It cannot share the main port — Immich only works
# at the root of a host, never under a subpath like /img/.
IMMICH_HOST_PORT=2283
# Alphanumeric only, no special characters. Generate with:
#   LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32
IMMICH_DB_PASSWORD=

TZ=Europe/Sarajevo

# Common user/group IDs (same for all services requiring them)
PUID=1000
PGID=1000

# --- PIA (gluetun) ---
# Prowlarr's indexer lookups exit through this tunnel. Your regular PIA login,
# not the separate SOCKS5 credentials.
PIA_USERNAME=
PIA_PASSWORD=
# Comma-separated; gluetun picks one at random on each (re)connect. Names must
# match PIA's exactly — check with:
#   docker run --rm qmcgaw/gluetun format-servers -private-internet-access
PIA_REGIONS=Bosnia and Herzegovina,Croatia,Serbia,Slovenia,Austria
